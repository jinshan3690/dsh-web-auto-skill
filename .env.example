# LLM 配置（可选 —— 不填也能跑：无模型时走本地规则规划器）
# LLM_PROVIDER=auto     # auto | none | external
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 指向本地模型/自建网关（如 Ollama http://127.0.0.1:11434/v1）时无需 key
# OPENAI_API_KEY=sk-xxx

# 存储
# 默认 ~/.web-auto-skill/storage（不随包目录走，重装不丢数据）；想放项目内就改成 ./storage
# STORAGE_ROOT=./storage

# 学习策略
MAX_SKILL_VERSIONS=5
AUTO_LEARN=true

# 浏览器
# 留空自动探测系统 Chrome → Edge → Brave，都没有才用 playwright 自带 chromium。
# 想强制指定就写 channel 名；写成空串（CHROMIUM_CHANNEL=）表示用自带 chromium。
# CHROMIUM_CHANNEL=chrome
# 接管浏览器（复用登录态），不用每次新开一个。
# 默认自动：有可接管的就复用，没有就用专用 profile 拉起一个 —— 不需要先手动开窗口。
#   BROWSER_CDP_AUTO=false  关掉，回到「每次自拉临时浏览器、跑完销毁」
#   BROWSER_CDP_PORT=9222   调试端口起点（被占时自动顺延）
#   BROWSER_PROFILE_DIR=    专用数据目录，登录态存这里（Chrome 136+ 必须独立于默认 profile）
# 想接管「你自己已经开着的」浏览器，就显式给地址（设了它就不再自动拉起）：
# BROWSER_CDP_URL=http://127.0.0.1:9222

# Embedding（语义召回 Skill，不消耗 LLM token）
# auto: 优先本地 ONNX（22MB，无需 PyTorch）→ sentence-transformers → n-gram 兜底
# 只需 pip install onnxruntime tokenizers huggingface_hub 然后 python -m web_auto_skill embed-setup
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_BACKEND=auto
# EMBED_THREADS=2
# EMBED_ONNX_DIR=./storage/models/bge-small-zh-v1.5

# 检测到登录页/验证码时停下来提示用户（不代客登录、不存会话）
HUMAN_HINT=true

# ---------- HTTP 服务安全 ----------
# 设置后所有业务接口要求 Authorization: Bearer <token>
# 只在本机用可留空；只要不是 127.0.0.1 监听就必须设置
# WEB_AUTO_SKILL_API_TOKEN=change-me
# 允许 page_key 指向内网/环回地址（自建 OA、本机页面需要打开它）
ALLOW_PRIVATE_NETWORK=false
# 允许 file:// 页面（仅本地调试）
ALLOW_FILE_URL=false
# 同时执行的浏览器任务上限
MAX_CONCURRENT_TASKS=2

